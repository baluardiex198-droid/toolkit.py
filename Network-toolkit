import socket
import requests
import json
import sys

def ip_lookup(ip_address):
    print(f"\n[+] Fetching Info for IP: {ip_address}...")
    try:
        # Using a free public API for IP details
        response = requests.get(f"http://ip-api.com{ip_address}")
        data = response.json()
        
        if data['status'] == 'success':
            print("\n=== IP INFORMATION ===")
            print(f"Country      : {data.get('country')}")
            print(f"Region/State : {data.get('regionName')}")
            print(f"City         : {data.get('city')}")
            print(f"ISP          : {data.get('isp')}")
            print(f"Organization : {data.get('org')}")
            print(f"Latitude     : {data.get('lat')}")
            print(f"Longitude    : {data.get('lon')}")
        else:
            print("[-] Invalid IP or details not found.")
    except Exception as e:
        print(f"[-] Error fetching IP details: {e}")

def port_scanner(target_host):
    print(f"\n[+] Scanning common ports on: {target_host}...")
    # Common ports to check
    common_ports = [21, 22, 23, 80, 443, 8080]
    
    try:
        target_ip = socket.gethostbyname(target_host)
        print(f"[+] Target IP resolved to: {target_ip}\n")
        
        for port in common_ports:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(1.0) # 1 second timeout
            result = s.connect_ex((target_ip, port))
            if result == 0:
                print(f"  --> Port {port}: OPEN")
            s.close()
        print("\n[+] Scan completed.")
    except socket.gaierror:
        print("[-] Hostname could not be resolved.")
    except Exception as e:
        print(f"[-] Error during scan: {e}")

if __name__ == "__main__":
    print("====================================")
    print("     OSINT & NETWORK TOOLKIT        ")
    print("====================================")
    print("1. IP Address Lookup")
    print("2. Simple Port Scanner")
    print("3. Exit")
    
    choice = input("\nEnter your choice (1-3): ").strip()
    
    if choice == '1':
        ip = input("Enter Target IP Address: ").strip()
        if ip: ip_lookup(ip)
    elif choice == '2':
        host = input("Enter Target Domain (e.g., google.com): ").strip()
        if host: port_scanner(host)
    elif choice == '3':
        print("Exiting...")
        sys.exit()
    else:
        print("Invalid Choice.")
